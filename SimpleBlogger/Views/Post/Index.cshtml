@using SimpleBlogger.Models.ViewModels
@model List<PostWithTagAndFilterViewModel>
@using System.Security.Claims

<div class="mb-3">
    <!--The line below is really cool!-->
    <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.Filter == null ? "active" : "")">All</a>
    @foreach (var tag in ViewBag.Tags)
    {
        <a asp-action="Index" asp-route-filter="@tag.Name"
           class="btn btn-outline-primary @(ViewBag.Filter == tag.Name ? "active" : "")">@tag.Name</a>
    }
</div>

@foreach(var post in Model)
{      
    <div class="post">
        @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == post.UserId)
        {
            <b>This is your post!</b>
        }

        <h2><a asp-action="Details" asp-route-id="@post.Id">@post.Title</a></h2>

        <p>@Html.Raw(post.Body)</p>
        <p>Tag: @post.AssignedTag?.Name</p>
        @*<a asp-action="Details" asp-route-id="@post.Id">View Details</a>*@
        <form asp-action="Delete" asp-route-id="@post.Id" method="post">
            <button type="submit">Delete</button>
        </form>
        @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == post.UserId)
        {
            <br />
            <a asp-action="Edit" asp-route-id="@post.Id">
                <button type="submit">Edit</button>
            </a>
        }
        


    </div>
    <br /> 
}
